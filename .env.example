# Database — matches docker-compose.yml (Postgres on host port 5433)
DATABASE_URL=postgresql://bracket:bracket@127.0.0.1:5433/bracket?schema=public

# Redis — BullMQ requires Redis 5+ (`docker compose up -d` exposes 6380)
REDIS_URL=redis://127.0.0.1:6380
REDIS_ENABLED=false

# API
JWT_SECRET=change-me-in-production-use-long-random-string
HOST=127.0.0.1
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3002,http://localhost:3000
WEBHOOK_URL=

# Public web URL (used in emails, QR codes, embed snippets)
APP_URL=http://localhost:3000

# Email (optional — Resend for verification / password reset / result emails)
RESEND_API_KEY=
EMAIL_FROM=Bracket <onboarding@resend.dev>

# Stripe (optional — Premier subscriptions, paid registrations, event tickets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIER_MONTHLY=
STRIPE_PRICE_PREMIER_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Plan limits
FREE_MAX_PARTICIPANTS=256
PREMIER_MAX_PARTICIPANTS=512
FREE_MAX_ACTIVE_TOURNAMENTS=0

# Sentry (optional — no-op when empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
