# Database — matches docker-compose.yml (Postgres on host port 5433)
DATABASE_URL=postgresql://bracket:bracket@localhost:5433/bracket?schema=public

# Redis — BullMQ requires Redis 5+ (`docker compose up -d` exposes 6380)
REDIS_URL=redis://localhost:6380
REDIS_ENABLED=false

# API
JWT_SECRET=change-me-in-production-use-long-random-string
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3002,http://localhost:3000
WEBHOOK_URL=

# Email (optional — Resend for verification / result emails)
RESEND_API_KEY=

# Sentry (optional — no-op when empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
